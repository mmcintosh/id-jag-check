#!/bin/sh
# Checks a commit message against the same patterns as .github/workflows/commit-text.yml.
# Turn it on in your clone: git config core.hooksPath .githooks
names='claude|anthropic|copilot|openai|chatgpt|codex|gemini|bard|cursor|codeium|windsurf|devin|aider|tabnine|codewhisperer|amazon ?q|sweep|mutable\.ai|grok|greptile|coderabbit|qodo|sourcery|ellipsis'
if grep -inE "co-authored-by:.*($names)|generated (with|by) \[?($names)|noreply@anthropic\.com|claude\.(ai|com)/code|chatgpt\.com|copilot-swe-agent" "$1"; then
  echo "Commit message not accepted: see the lines above." >&2
  exit 1
fi
